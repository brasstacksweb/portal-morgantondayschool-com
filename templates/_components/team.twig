{##
 # Team component
 # @param {Entry} team
 # @param {bool} expand
 #}

{# Params #}
{% set team = team ?? null %}

{# Variables #}
{% set handle = 'team' %}

{% set stats = craft.signups.getTeamStats(team) %}
{% set state = stats.state %}
{% set committed = stats.committed %}
{% set interested = stats.interested %}
{% set remaining = stats.remaining %}
{% set isOpen = stats.isOpen %}
{% set minimum = team.minimumPlayers %}
{% set userSignups = craft.signups.getSignupsForUserAndTeam(currentUser.id, team.id) %}
{% set expanded = expand or userSignups|length > 0 %}
{% set canViewContact = craft.signups.canViewContact(currentUser) %}
{% set roster = craft.signups.getRoster(team.id) %}
{% set consentForm = team.sport[0].consentForm[0] ?? null %}

{% set stateLabels = {
	'pending': 'Upcoming',
	'forming': 'Forming',
	'confirmed': 'Open',
	'over-target': 'Full',
	'closed': 'Closed',
} %}

{% set stateMessage %}
	{% switch state %}
	{% case 'pending' %}
		Registration opens {{ team.registrationOpens|date('F j, Y') }}.
	{% case 'forming' %}
		{{ committed }} of {{ minimum }} committed to field a team — {{ minimum - committed }} more to go.
	{% case 'confirmed' %}
		Team confirmed · {{ remaining }} spot{{ remaining == 1 ? '' : 's' }} left.
	{% case 'over-target' %}
		Target met — additional signups may form a second team.
	{% case 'closed' %}
		Registration is closed.
	{% endswitch %}
{% endset %}

{# Markup #}

{% import '_icons' as icons %}

<div class="{{ handle }} {{ handle }}--{{ state }}">
	<details {% if expanded %}open{% endif %}>
		<summary>
			<hgroup>
				<h2>{{ team.ageGroup }}</h2>
				<p>
					{{ team.season.label }} {{ team.startYear }}–{{ (team.startYear + 1) % 100 }}
					{% if team.coaches|length %}
						· Coach{{ team.coaches|length > 1 ? 'es' }}: {{ team.coaches|map(c => c.title)|join(', ') }}
					{% endif %}
				</p>
			</hgroup>
			<p>
				<mark>{{ stateLabels[state] }}</mark>
				<small>{{ committed }} committed</small>
			</p>
			<i>{{ icons.chevron('down') }}</i>
		</summary>
		<div>
			<p role="status">
				{{ stateMessage }}
				<small>
					<strong>{{ committed }} committed</strong>
					{% if interested %} · {{ interested }} interested{% endif %}
				</small>
			</p>

			{% if team.eligibilityNotes is not empty %}
				<h3>Eligibility</h3>
				<div role="details">{{ team.eligibilityNotes }}</div>
			{% endif %}

			{% if team.practiceInfo is not empty %}
				<h3>Practice</h3>
				<div role="details">{{ team.practiceInfo }}</div>
			{% endif %}

			{% if team.gamesInfo is not empty %}
				<h3>Games</h3>
				<div role="details">{{ team.gamesInfo }}</div>
			{% endif %}

			<h3>Roster</h3>
			{% include '_components/roster' with {
				roster: roster,
				canViewContact: canViewContact,
			} only %}

			{% if userSignups is not empty %}
				<h3>Your registrations</h3>
				{% include '_components/signup-panel' with {
					signups: userSignups,
					canCommit: isOpen,
				} only %}
			{% endif %}

			{% if isOpen %}
				<nav>
					{% include '_components/form-dialog' with {
						id: 'signup-dialog-' ~ team.id,
						triggerLabel: userSignups|length ? 'Register another child' : 'Register',
						heading: 'Register — ' ~ team.ageGroup,
						form: craft.signups.newSignup({
							teamEntryId: team.id,
							guardianEmail: currentUser.email,
							redirect: craft.app.request.getAbsoluteUrl() ~ '#notice',
						}),
					} only %}
					{% if consentForm %}
						<a href="{{ consentForm.url }}" target="_blank" rel="noopener noreferrer">
							{% include '_components/cta' with {
								title: consentForm.ctaLabel ?? 'Print and Sign Consent Form',
								'type': 'tertiary',
							} only %}
						</a>
					{% endif %}
				</nav>
			{% endif %}
		</div>
	</details>
</div>
