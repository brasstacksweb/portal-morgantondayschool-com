{##
 # Team — the body content of a team accordion (the <details>/<summary> shell is
 # owned by team-list). Renders standalone too via the ?? defaults.
 # @param {Entry}          team
 # @param {string}         state       precomputed team state (optional)
 # @param {int}            committed   precomputed committed count (optional)
 # @param {SignupRecord[]} mySignups   the user's signups for this team (optional)
 #}

{# Params #}
{% set team = team ?? null %}
{% set state = state ?? craft.signups.getTeamState(team) %}
{% set committed = committed ?? craft.signups.getCommittedCount(team.id) %}
{% set mySignups = mySignups ?? craft.signups.getSignupsForUserAndTeam(currentUser.id, team.id) %}

{# Variables #}
{% set isOpen = craft.signups.isRegistrationOpen(team) %}
{% set interested = craft.signups.getInterestedCount(team.id) %}
{% set minimum = team.minimumPlayers %}
{% set remaining = craft.signups.getRemainingCapacity(team) %}
{% set canViewContact = craft.signups.canViewContact(currentUser) %}
{% set roster = craft.signups.getRoster(team.id, canViewContact) %}

{% import '_icons' as icons %}

{% set stateMessage %}
	{% if state == 'pending' %}
		Registration opens {{ team.registrationOpens|date('F j, Y') }}.
	{% elseif state == 'forming' %}
		{{ committed }} of {{ minimum }} committed to field a team — {{ minimum - committed }} more to go.
	{% elseif state == 'confirmed' %}
		Team confirmed · {{ remaining }} spot{{ remaining == 1 ? '' : 's' }} left.
	{% elseif state == 'over_target' %}
		Target met — additional signups may form a second team.
	{% elseif state == 'closed' %}
		Registration is closed.
	{% endif %}
{% endset %}

{# Markup — the disclosure body #}
<div>
	<p>
		{{ stateMessage }}
		<small><strong>{{ committed }}</strong> committed{% if interested %} · {{ interested }} interested{% endif %}</small>
	</p>

	{% if team.eligibilityNotes %}
		<section>
			<h3>Eligibility</h3>
			{{ team.eligibilityNotes }}
		</section>
	{% endif %}
	{% if team.practiceInfo %}
		<section>
			<h3>Practice</h3>
			{{ team.practiceInfo }}
		</section>
	{% endif %}

	{% include '_components/roster' with {
		roster: roster,
		canViewContact: canViewContact,
	} only %}

	{% if mySignups|length %}
		{% include '_components/signup-panel' with {
			signups: mySignups,
			team: team,
			canCommit: isOpen,
		} only %}
	{% endif %}

	{% if isOpen %}
		<tl-dialog class="signup-dialog">
			<button type="button">
				{% include '_components/cta' with {
					title: mySignups|length ? 'Register another child' : 'Register',
					type: 'primary',
				} only %}
			</button>
			<dialog>
				<button type="button" aria-label="Close">{{ icons.x() }}</button>
				<h3>Register — {{ team.ageGroup }}</h3>
				{% include '_components/form' with {
					form: create({
						class: 'modules\\athletics\\models\\Signup',
						teamEntryId: team.id,
						guardianEmail: currentUser.email,
						redirect: craft.app.request.absoluteUrl ~ '#notice',
					}),
				} only %}
			</dialog>
		</tl-dialog>
	{% endif %}
</div>
