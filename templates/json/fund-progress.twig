{##
 # Titan Fund progress json
 #
 # Lets the banner re-read the totals without a page load, which is what makes
 # the bar move under the confetti after a donation.
 #}

{# Controller #}
{% set campaign = craft.donations.getCampaign() %}
{% set progress = campaign ? craft.donations.getProgress(campaign) : null %}

{% set markup %}
	{% if progress %}
		{% include '_components/fund-progress-bar' with { progress: progress } only %}
	{% endif %}
{% endset %}

{# Res #}
{% header 'Content-Type: application/json' %}

{#
	The CSRF token rides along because the donate form is rendered inside the
	homepage cache and cannot carry one of its own. This template is never
	cached, and a cross-origin read of it is opaque, so it is the same exposure
	as Craft's own users/session-info action.
#}
{{ {
	markup: markup|trim,
	csrfToken: craft.app.request.csrfToken,
}|json_encode|raw }}
