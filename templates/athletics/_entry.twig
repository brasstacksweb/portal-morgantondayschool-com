{##
 # Sport entry — athletics signups
 # @param {Entry} entry  the sport
 #}

{# Gate: authenticated users only #}
{% if not currentUser %}
	{% redirect 'login?redirect=' ~ craft.app.request.url|url_encode %}
{% endif %}

{# Variables #}
{% set teams = entry.activeTeams.with(['sport', 'coaches']).all() %}
{% set flashError = craft.app.getSession().getError() %}
{% set flashSuccess = craft.app.getSession().getSuccess() %}

{# Meta #}
{% set metaTitle = entry.heading ?? entry.title %}
{% set metaNoIndex = true %}

{% extends '_layouts/html' %}

{% set loadForm = true %}

{% block content %}
	<article class="athletics">
		<header class="athletics__header">
			<h1>{{ entry.heading ?? entry.title }}</h1>
			{% if entry.overview %}
				<div class="athletics__overview">{{ entry.overview }}</div>
			{% endif %}
		</header>

		{% if flashError or flashSuccess %}
			<p class="athletics__flash athletics__flash--{{ flashError ? 'error' : 'success' }}">
				{{ flashError ?? flashSuccess }}
			</p>
		{% endif %}

		{% if teams is empty %}
			<p class="athletics__empty">No teams are open for signup yet. Please check back soon.</p>
		{% else %}
			<div class="athletics__teams">
				{% for team in teams %}
					{% include '_components/team' with { team: team } only %}
				{% endfor %}
			</div>
		{% endif %}
	</article>
{% endblock %}
