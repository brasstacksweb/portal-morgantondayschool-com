{##
 # Sport entry — athletics signups
 # @param {Entry} entry  the sport
 #}

{# Gate: authenticated users only #}
{% if not currentUser %}
	{% redirect 'login?redirect=' ~ craft.app.request.url|url_encode %}
{% endif %}

{# Variables #}
{% set heroImage = entry.heroImage.one() %}
{% set teams = entry.activeTeams.with(['sport', 'coaches']).all() %}
{% set flashError = craft.app.getSession().getError() %}
{% set flashSuccess = craft.app.getSession().getSuccess() %}

{# Meta #}
{% set metaTitle = entry.heading ?? entry.title %}
{% set metaDescription = entry.overview|striptags[:160] %}
{% set metaNoIndex = true %}

{% extends '_layouts/html' %}

{% set loadForm = true %}

{% block content %}
	<article>
		<header>
			{% include '_components/hero' with {
				heading: entry.heading ?? entry.title,
				body: entry.overview,
				image: heroImage,
				backgroundColor: entry.color.value,
			} only %}
		</header>

		<section>
			{% include '_components/team-list' with {
				teams: teams,
				flashError: flashError,
				flashSuccess: flashSuccess,
			} only %}
		</section>
	</article>
{% endblock %}
