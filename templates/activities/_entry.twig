{##
 # Activity entry
 # @param {Entry} entry
 #}

{# Params #}
{% set heroImage = entry.heroImage.one() %}
{% set ctas = entry.ctas.with([
	'pageCta:page',
]).all() %}
{% set activityModules = entry.activityModules.with([
	'accordionList:accordions.textBlock:cta.pageCta:page',
	'cardList:cards.card:image',
	'cardList:cards.card:cta.pageCta:page',
	'media:image',
	'mediaSplit:image',
	'mediaSplit:cta.pageCta:page',
	'textList:textlist.textBlock:cta.pageCta:page',
]).all() %}

{# Markup #}
{% set metaTitle = entry.heading ?? entry.title ?? '' %}
{% set metaDescription = entry.overview|striptags[:160] %}
{% set metaNoIndex = true %}
{# reCAPTCHA for the Titan Fund donate form, which only renders once Stripe is set up #}
{% set loadForm = craft.checkout.isConfigured() %}

{% extends '_layouts/html' %}

{% block content %}
	{% cache if not devMode %}
		<article>
			{#
				Opt-in per entry (showTitanFundTicker), same component and gating as
				the homepage. craft.donations.getCampaign() is queried inside this
				cache block, not above it, so the cache's own lifetime is capped at
				the campaign's expiryDate the same way the homepage's is — queried
				above the block, this would outlive its campaign.
			#}
			{% if entry.showTitanFundTicker %}
				{% set campaign = craft.donations.getCampaign() %}
				{% if campaign %}
					{% include '_components/fund-progress' with {
						campaign: campaign,
					} only %}
				{% endif %}
			{% endif %}

			<header>
				{% include '_components/hero' with {
					image: heroImage,
					heading: entry.heading,
					subheading: entry.date,
					body: entry.overview,
					ctas: ctas,
					backgroundColor: 'violet',
				} only %}
			</header>

			{% for m in activityModules %}
				{{ m.render() }}
			{% endfor %}
		</article>
	{% endcache %}
{% endblock %}
